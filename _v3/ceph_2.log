          OPERATOR=$(kubectl get pod -n rook-ceph -l app=rook-ceph-operator -o jsonpath='{.items[0].metadata.name}')
          kubectl exec -n rook-ceph "$OPERATOR" -- ceph -s 2>/dev/null || echo "Cannot reach ceph from operator pod"
        else
          kubectl exec -n rook-ceph "$TOOLBOX" -- ceph -s
