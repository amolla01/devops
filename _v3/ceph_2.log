    cmd: |-
        echo "Waiting for MON pods to be created by operator..."
        for i in $(seq 1 60); do
          MON_COUNT=$(kubectl get pods -n rook-ceph -l app=rook-ceph-mon --no-headers 2>/dev/null | wc -l)
          if [ "$MON_COUNT" -ge 1 ]; then
            echo "MON pod found, waiting for ready..."
            kubectl wait --for=condition=ready pod      -l app=rook-ceph-mon      -n rook-ceph      --timeout=120s 2>&1
            exit $?
          fi
          sleep 5
        done
        echo "WARNING: No MON pods created after 5 minutes — operator may still be initializing"
        exit 0
