ok: [Host34_1] => (item=/dev/vdb) =>
    ansible_loop_var: item
    changed: false
    cmd: |-
        DEV="/dev/vdb"
        # Use lsblk to verify device exists (test -b is unreliable after sgdisk --zap-all)
        if ! lsblk "$DEV" >/dev/null 2>&1; then
          echo "SKIP (not found): $DEV"
          exit 0
        fi
        if lsblk -n -o MOUNTPOINT "$DEV" 2>/dev/null | grep -q '/'; then
          echo "SKIP (mounted): $DEV"
          exit 0
        fi
        # Refresh kernel partition table first
        partprobe "$DEV" 2>/dev/null || true
        wipefs -af "$DEV" 2>/dev/null || true
        dd if=/dev/zero of="$DEV" bs=1M count=100 2>/dev/null || true
        sgdisk --zap-all "$DEV" 2>/dev/null || true
        partprobe "$DEV" 2>/dev/null || true
        echo "WIPED: $DEV"
    delta: '0:00:00.011334'
