TASK [TEARDOWN | Wait for namespace to fully terminate] *********************************************************************************************************************************************************
ok: [Host12_1] =>
    changed: false
    cmd: |-
        for i in $(seq 1 60); do
          if ! kubectl get ns rook-ceph 2>/dev/null | grep -q Terminating; then
            echo "Namespace gone"
            exit 0
          fi
          sleep 5
        done
        # Force-remove finalizers if stuck
        kubectl get ns rook-ceph -o json 2>/dev/null |  python3 -c 'import json,sys; ns=json.load(sys.stdin); ns["spec"]["finalizers"]=[]; print(json.dumps(ns))' |  kubectl replace --raw "/api/v1/namespaces/rook-ceph/finalize" -f - 2>/dev/null || true
        echo "Namespace force-finalized"
    delta: '0:02:29.479111'
    end: '2026-06-04 03:19:03.373601'
    msg: ''
    rc: 0
    start: '2026-06-04 03:16:33.894490'
    stderr: ''
    stderr_lines: <omitted>
    stdout: Namespace gone
    stdout_lines: <omitted>

