TASK [TEARDOWN | Remove CephCluster finalizers (prevents namespace hang)] ***************************************************************************************************************************************
changed: [Host12_1] =>
    changed: true
    cmd: |-
        for resource in cephcluster cephblockpool cephfilesystem cephobjectstore; do
          for item in $(kubectl get $resource -n rook-ceph -o name 2>/dev/null); do
            kubectl patch $item -n rook-ceph --type merge      -p '{"metadata":{"finalizers":null}}' 2>/dev/null || true
          done
        done
    delta: '0:00:01.907188'
    end: '2026-06-04 03:13:50.329225'
