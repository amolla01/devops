TASK [Get dashboard service external endpoint] ******************************************************************************************************************************************************************
ok: [Host12_1] =>
    changed: false
    cmd: |-
        LB_IP=$(kubectl get svc rook-ceph-mgr-dashboard -n rook-ceph  -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)
        if [ -n "$LB_IP" ]; then
          echo "$LB_IP:8443"
        else
          NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')
          NODE_PORT=$(kubectl get svc rook-ceph-mgr-dashboard -n rook-ceph    -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo '8443')
          echo "$NODE_IP:$NODE_PORT (fallback — MetalLB IP not assigned)"
        fi
