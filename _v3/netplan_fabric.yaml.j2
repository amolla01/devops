# Netplan fabric configuration — managed by Ansible
# {{ ansible_managed }}
#
# KVM Lab Note: Ubuntu Noble cloud images use predictable interface names:
#   enp1s0 = PCI bus 1 slot 0 (mgmt NIC0)
#   enp2s0 = PCI bus 2 slot 0 (fabric NIC1 → first leaf)
#   enp3s0 = PCI bus 3 slot 0 (fabric NIC2 → second leaf)
#
# Physical Hardware: Uses eth0/eth1/eth2 (or eno1/eno2 depending on NIC vendor)
#
# The netplan variable in host_vars uses logical names (eth0/eth1/eth2) for
# physical hardware. For KVM lab, interface names are auto-mapped below.
#
{% set _is_kvm = automation_profile | default('win11_kvm') in ['win11_kvm', 'ubuntu_r620_kvm', 'ubuntu_r810_kvm'] %}
{% set _iface_map = {
   physical_interface_map.fabric0: kvm_interface_map.fabric0,
   physical_interface_map.fabric1: kvm_interface_map.fabric1,
   physical_interface_map.mgmt: kvm_interface_map.mgmt
} if _is_kvm else {} %}
{% set _network = netplan.network %}
{% set _fabric_names = fabric_interfaces | default([]) | map(attribute='name') | list %}
{% set _render_ns = namespace(ethernets={}) %}
{% for _name, _cfg in (_network.ethernets | default({})).items() %}
{% set _render_name = _iface_map[_name] | default(_name) %}
{% set _render_cfg = _cfg %}
{% if _name in _fabric_names %}
{% set _render_cfg = _render_cfg | combine({
    'dhcp4': false,
    'dhcp6': false,
    'link-local': ['ipv6'],
    'accept-ra': false
 }, recursive=True) %}
{% endif %}
{% set _render_ns.ethernets = _render_ns.ethernets | combine({_render_name: _render_cfg}, recursive=True) %}
{% endfor %}
{% set _rendered_network = {
   'network': {
      'version': _network.version,
      'renderer': _network.renderer,
      'ethernets': _render_ns.ethernets
   }
} %}
{% if _network.vlans is defined and (_network.vlans | length) > 0 %}
{% set _rendered_network = _rendered_network | combine({'network': {'vlans': _network.vlans}}, recursive=True) %}
{% endif %}
{{ _rendered_network | to_nice_yaml }}
