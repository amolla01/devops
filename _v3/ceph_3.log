TASK [TEARDOWN | Strip finalizers from ALL Rook custom resources] ***********************************************************************************************************************************************
changed: [Host12_1] =>
    changed: true
    cmd: |-
        RESOURCES="cephcluster cephblockpool cephfilesystem cephobjectstore
                   cephfilesystemsubvolumegroup cephclient cephnfs
                   cephobjectstoreuser cephobjectrealm cephobjectzonegroup
                   cephobjectzone cephrbdmirror cephfilesystemmirror
                   cephblockpoolradosnamespace cephbucketnotification
                   cephbuckettopic"
        for resource in $RESOURCES; do
          for item in $(kubectl get $resource -n rook-ceph -o name 2>/dev/null); do
            kubectl patch $item -n rook-ceph --type merge      -p '{"metadata":{"finalizers":null}}' 2>/dev/null || true
          done
        done
        echo "All finalizers stripped"
