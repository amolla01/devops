TASK [Wipe OSD devices (only if empty/unformatted)] *************************************************************************************************************************************************************
changed: [Host12_2] => (item=/dev/vdb) =>
    ansible_loop_var: item
    changed: true
    cmd: |-
        DEV=/dev/vdb
        DEVNAME=$(basename "$DEV")
        # Check device existence via sysfs (works regardless of DM/LVM state)
        if [ ! -d "/sys/block/$DEVNAME" ]; then
          echo "SKIP (not found): $DEV"
          exit 0
        fi
        # Check if mounted (use findmnt which doesn't choke on stale DM)
        if findmnt -rn -S "$DEV" >/dev/null 2>&1; then
          echo "SKIP (mounted): $DEV"
          exit 0
        fi
        # Remove any stale device-mapper entries (LVM from previous Ceph OSD)
        for dm in $(ls /sys/block/$DEVNAME/holders/ 2>/dev/null); do
          dmsetup remove -f "$dm" 2>/dev/null || true
        done
        # Also deactivate any LVM VGs on this device
        pvs "$DEV" --noheadings -o vg_name 2>/dev/null | while read VG; do
          [ -n "$VG" ] && vgremove -f "$VG" 2>/dev/null || true
        done
        # Now wipe
        wipefs -af "$DEV" 2>/dev/null || true
        dd if=/dev/zero of="$DEV" bs=1M count=100 2>/dev/null || true
        sgdisk --zap-all "$DEV" 2>/dev/null || true
        partprobe "$DEV" 2>/dev/null || true
        echo "WIPED: $DEV"
    delta: '0:00:02.903694'
    end: '2026-06-04 23:25:43.376730'
    item: /dev/vdb
    msg: ''
    rc: 0
    start: '2026-06-04 23:25:40.473036'
    stderr: ''
    stderr_lines: <omitted>
    stdout: |-
        Creating new GPT entries in memory.
        Warning: The kernel is still using the old partition table.
        The new table will be used at the next reboot or after you
        run partprobe(8) or kpartx(8)
        GPT data structures destroyed! You may now partition the disk using fdisk or
        other utilities.
        WIPED: /dev/vdb
    stdout_lines: <omitted>
