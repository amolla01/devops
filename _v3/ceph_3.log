        for dm in $(ls /sys/block/$DEVNAME/holders/ 2>/dev/null); do
          dmsetup remove -f "$dm" 2>/dev/null || true
        done
        # Deactivate LVM VGs, then remove PV label
        pvs "$DEV" --noheadings -o vg_name 2>/dev/null | while read VG; do
          [ -n "$VG" ] && vgchange -an "$VG" 2>/dev/null || true
          [ -n "$VG" ] && vgremove -f "$VG" 2>/dev/null || true
        done
        pvremove -ff "$DEV" 2>/dev/null || true
        # Wipe ALL signatures (filesystem, RAID, LVM, Ceph BlueStore)
        wipefs -af "$DEV" 2>/dev/null || true
        # Zero first 100MB (GPT header, LVM PV header, BlueStore superblock)
        dd if=/dev/zero of="$DEV" bs=1M count=100 2>/dev/null || true
        # Zero last 100MB (backup GPT, BlueStore label at end of device)
        DEV_SIZE=$(blockdev --getsize64 "$DEV" 2>/dev/null || echo 0)
        if [ "$DEV_SIZE" -gt 104857600 ]; then
          dd if=/dev/zero of="$DEV" bs=1M count=100    seek=$(( (DEV_SIZE / 1048576) - 100 )) 2>/dev/null || true
        fi
        # Zap GPT/MBR partition table
        sgdisk --zap-all "$DEV" 2>/dev/null || true
        partprobe "$DEV" 2>/dev/null || true
        echo "WIPED: $DEV"
