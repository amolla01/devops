TASK [Create rook-ceph namespace] *******************************************************************************************************************************************************************************
changed: [Host12_1] =>
    changed: true
    cmd: |-
        # Wait if namespace is still terminating from a prior teardown
        for i in $(seq 1 30); do
          STATUS=$(kubectl get ns rook-ceph -o jsonpath='{.status.phase}' 2>/dev/null || echo "NotFound")
          if [ "$STATUS" = "NotFound" ] || [ -z "$STATUS" ]; then
            kubectl create namespace rook-ceph
            exit $?
          elif [ "$STATUS" = "Active" ]; then
            echo "Namespace already exists and active"
            exit 0
          fi
          echo "Namespace is $STATUS, waiting..."
          sleep 5
        done
        echo "ERROR: Namespace stuck in Terminating state after 150s"
        exit 1
    delta: '0:00:00.292229'
    end: '2026-06-05 04:43:45.270881'
    msg: ''
