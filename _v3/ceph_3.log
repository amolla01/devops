TASK [TEARDOWN | Force-finalize namespace if stuck in Terminating] **********************************************************************************************************************************************
ok: [Host12_1] =>
    changed: false
    cmd: |-
        for i in $(seq 1 24); do
          STATUS=$(kubectl get ns rook-ceph -o jsonpath='{.status.phase}' 2>/dev/null || echo "NotFound")
          if [ "$STATUS" = "NotFound" ] || [ -z "$STATUS" ]; then
            echo "Namespace gone"
            exit 0
          fi
          if [ "$STATUS" = "Terminating" ]; then
            # Force-remove namespace finalizers via API
            kubectl get ns rook-ceph -o json |      python3 -c 'import json,sys; ns=json.load(sys.stdin); ns["spec"]["finalizers"]=[]; print(json.dumps(ns))' |      kubectl replace --raw "/api/v1/namespaces/rook-ceph/finalize" -f - 2>/dev/null || true
          fi
          sleep 5
        done
        # Final check
        if kubectl get ns rook-ceph 2>/dev/null; then
          echo "WARNING: Namespace still exists after 120s"
          exit 1
        fi
        echo "Namespace removed"
    delta: '0:00:05.485165'
