            kubectl wait --for=condition=ready pod      -l app=rook-ceph-mon      -n rook-ceph      --timeout=120s 2>&1
            exit $?
          fi
          sleep 5
        done
        echo "WARNING: No MON pods created after 5 minutes — operator may still be initializing"
        exit 0
