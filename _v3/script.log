admin@LeafL1:~$ show runningconfiguration bgp
Building configuration...

Current configuration:
!
frr version 8.5.4
frr defaults traditional
hostname sonic
log syslog informational
log facility local4
agentx
hostname LeafL1
no service integrated-vtysh-config
!
password zebra
enable password zebra
!
router bgp 65011
 bgp router-id 10.0.1.1
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 neighbor Ethernet0 interface v6only remote-as 65101
 neighbor Ethernet0 description Host12_1
 neighbor Ethernet1 interface v6only remote-as 65102
 neighbor Ethernet1 description Host12_2
 neighbor Ethernet2 interface v6only remote-as 65103
 neighbor Ethernet2 description Host12_3
 neighbor Ethernet64 interface v6only remote-as external
 neighbor Ethernet64 description Spine_S2
 neighbor Ethernet68 interface v6only remote-as external
 neighbor Ethernet68 description Spine_S1
 !
 address-family ipv4 unicast
  redistribute connected
  neighbor Ethernet0 activate
  neighbor Ethernet0 soft-reconfiguration inbound
  neighbor Ethernet1 activate
  neighbor Ethernet1 soft-reconfiguration inbound
  neighbor Ethernet2 activate
  neighbor Ethernet2 soft-reconfiguration inbound
  neighbor Ethernet64 activate
  neighbor Ethernet68 activate
 exit-address-family
 !
 address-family ipv6 unicast
  redistribute connected
  neighbor Ethernet0 activate
  neighbor Ethernet1 activate
  neighbor Ethernet2 activate
  neighbor Ethernet64 activate
  neighbor Ethernet68 activate
 exit-address-family
 !
 address-family l2vpn evpn
  advertise-all-vni
 exit-address-family
exit
!
ip prefix-list PL_LoopbackV4 seq 5 permit 10.1.0.1/32
!
route-map RM_SET_SRC permit 10
exit
!
end

