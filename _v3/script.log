env:
# deploy_lab_v3.sh persistent environment settings.
# Sourced automatically on every invocation — no need to pass CLI flags.
# Override any value via CLI flags (they take precedence).

# Hypervisor targets (user@host or just host)
R810_HOST=nh1221@R810

# SSH key for passwordless auth to hypervisors
SSH_KEY_PATH=~/.ssh/id_dc_lab

# Default automation profile
AUTOMATION_PROFILE=ubuntu_r810_kvm

ansible.cfg
[defaults]
inventory = inventory/hosts.yml
roles_path = roles
host_key_checking = False
retry_files_enabled = False
interpreter_python = auto_silent
timeout = 30
stdout_callback = ansible.builtin.default
callback_result_format = yaml
[ssh_connection]
pipelining = True
ssh_args = -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30


