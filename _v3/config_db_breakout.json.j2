{# =============================================================================
   config_db_breakout.json.j2
   Port Breakout Configuration Patch for Arista 7050QX-32S
   =============================================================================
   Purpose:
     Generates a config_db.json patch that defines the BREAKOUT_CFG table
     and the resulting PORT entries for broken-out sub-ports. This template
     is used for reference/validation — the actual breakout is applied via
     the SONiC CLI ("config interface breakout") which handles the ASIC
     reprogramming.

   Context — Arista 7050QX-32S Ethernet0 (QSFP+5):
     - Index 5, lanes 9,10,11,12
     - Shares ASIC lanes with front-panel SFP+ ports 1-4
     - Default mode: 1x40G[10G] → single port "Ethernet0" (alias Ethernet5/1)
     - After 4x10G breakout:
         Parent "Ethernet0" is REMOVED
         Child ports created: Ethernet5/1(lane 9), Ethernet5/2(lane 10),
                              Ethernet5/3(lane 11), Ethernet5/4(lane 12)

   Applied BEFORE the fabric patch (deploy_fabric_spine_leaf.yml).
   The fabric patch then references "Ethernet5/1" (not "Ethernet0").

   Variables:
     - breakout_cfg: dict from host_vars defining parent ports and modes
     - exit_interfaces: list defining the sub-port to use for exit router
   =============================================================================#}
{% set exit_iface = exit_interfaces[0] %}
{
    "BREAKOUT_CFG": {
{% for parent_port, cfg in breakout_cfg.items() %}
        "{{ parent_port }}": {
            "brkout_mode": "{{ cfg.brkout_mode }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "PORT": {
{% for parent_port, cfg in breakout_cfg.items() %}
{% for child in cfg.child_ports %}
        "{{ child.port }}": {
            "admin_status": "{{ breakout_admin_status | default('up') }}",
            "alias": "{{ child.port }}",
            "index": "{{ cfg.get('index', '5') if cfg.get('index') is defined else '5' }}",
            "lanes": "{{ child.lane }}",
            "speed": "{{ child.speed }}",
            "mtu": "{{ breakout_exit_mtu | default('9100') }}",
            "description": "{{ child.port }} (breakout from {{ parent_port }}, {{ cfg.brkout_mode }})"
        }{{ "," if not loop.last else "" }}
{% endfor %}{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "INTERFACE": {
        "{{ exit_iface.port }}": {},
        "{{ exit_iface.port }}|{{ exit_iface.local_ip }}": {}
    },

    "BGP_NEIGHBOR": {
        "{{ exit_iface.neighbor_ip }}": {
            "asn": "{{ exit_iface.neighbor_asn }}",
            "name": "{{ exit_iface.neighbor }}",
            "local_addr": "{{ exit_iface.local_ip.split('/')[0] }}",
            "admin_status": "true",
            "holdtime": "{{ bgp_holdtime | default('180') }}",
            "keepalive": "{{ bgp_keepalive | default('60') }}",
            "nhopself": "0",
            "rrclient": "0"
        }
    },

    "BGP_NEIGHBOR_AF": {
        "{{ exit_iface.neighbor_ip }}|ipv4": {
            "admin_status": "true"
        },
        "{{ exit_iface.neighbor_ip }}|ipv6": {
            "admin_status": "true"
        }
    }
}
