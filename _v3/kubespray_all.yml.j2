---
# =============================================================================
# KubeSpray all.yml - Global cluster variables (profile-aware)
# =============================================================================
# Generated by: deploy_kubespray.yml (Phase 2)
# Automation profile: {{ automation_profile }}
# =============================================================================

## Directory where etcd data is stored
etcd_data_dir: /var/lib/etcd

## Container runtime (containerd is default and recommended)
container_manager: {{ container_runtime | default('containerd') }}

## Use systemd cgroup driver for containerd
containerd_use_systemd_cgroup: true

## Download settings — retry on failure, fail fast on unreachable registries
download_retries: 4
download_timeout: 300

## Download strategy — download on first control plane, distribute to others.
## download_run_once=true is efficient (1 pull from internet, then local push).
## Combined with download_localhost=false (uses first kube node, not deployer).
## The key fix for ProxyJump reliability is ansible_ssh_transfer_method=piped
## which avoids rsync/synchronize and uses Ansible's native copy pipeline.
download_run_once: true
download_localhost: false
download_cache_dir: /tmp/releases
download_force_cache: false
download_keep_remote_cache: true

## Cluster name
cluster_name: dc-lab-cluster

## NTP settings
ntp_enabled: true
ntp_manage_config: true
ntp_servers:
{% for server in ntp_servers | default(['0.pool.ntp.org', '1.pool.ntp.org']) %}
  - {{ server }}
{% endfor %}

## DNS settings
upstream_dns_servers:
{% for dns in dns_servers | default(['8.8.8.8', '8.8.4.4']) %}
  - {{ dns }}
{% endfor %}

## Disable firewall (managed by Calico network policies instead)
disable_firewalld: true

## Proxy configuration (profile-aware)
{% if automation_profile == 'win11_kvm' %}
http_proxy: "http://172.16.2.1:3128"
https_proxy: "http://172.16.2.1:3128"
{% elif automation_profile in ['ubuntu_r620_kvm', 'ubuntu_r810_kvm'] %}
http_proxy: "{{ lookup('env', 'HTTP_PROXY') | default('', true) }}"
https_proxy: "{{ lookup('env', 'HTTPS_PROXY') | default('', true) }}"
{% else %}
http_proxy: ""
https_proxy: ""
{% endif %}
no_proxy: "127.0.0.1,localhost,10.233.0.0/18,10.233.64.0/18,192.168.255.0/25,172.16.2.0/24,{% for host in groups['kube_nodes'] | default([]) %}{{ hostvars[host]['ansible_host'] }}{% if not loop.last %},{% endif %}{% endfor %}"

## Ansible SSH settings per profile
{% if automation_profile in ['win11_kvm', 'ubuntu_r620_kvm', 'ubuntu_r810_kvm'] %}
ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
ansible_ssh_retries: 3
## Use piped transfer to avoid rsync/synchronize failures through ProxyJump.
## This forces Ansible copy/fetch to use 'dd over ssh' instead of scp/sftp/rsync.
ansible_ssh_transfer_method: piped
{% endif %}
