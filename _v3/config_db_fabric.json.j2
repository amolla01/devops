{# =============================================================================
   config_db_fabric.json.j2
   Phase 2: Fabric Integration — IMPACTED-PORT-ONLY PATCH template
   =============================================================================
   Strategy:
     Renders ONLY the config_db sections required for the specific fabric
     ports in _fabric_links. That set is pre-filtered by sonic_fabric/tasks/
     main.yml to contain ONLY the ports whose neighbor is also in the current
     Ansible play. This guarantees:
       - A run targeting Spine_S1,Leaf_L1 touches exactly ONE port on each.
       - Ports connecting to nodes not in the play are left completely alone.
       - Non-fabric ports (server downlinks etc.) are never modified.

   Applied via: sonic-cfggen -d -j patch.json --write-to-db
     -d   reads the full current running config from Redis
     -j   overlays ONLY the keys present in this patch on top
     --write-to-db  writes the merged result back — untouched tables intact

   Tables rendered (all scoped to _fabric_links ports only):
     PORT          — speed, MTU, FEC, description for each fabric link port
     BREAKOUT_CFG  — port breakout mode (only fabric ports needing breakout)
     INTERFACE     — IPv6 link-local on each fabric port (eBGP unnumbered)
     BGP_NEIGHBOR  — one eBGP unnumbered session per fabric link
     BGP_NEIGHBOR_AF — IPv4 + IPv6 unicast AF per neighbor
     BGP_GLOBALS   — local ASN, router-id, multipath-relax (whole-router)
     BGP_GLOBALS_AF — ECMP max-paths for IPv4 + IPv6 (whole-router)
     DEVICE_METADATA — bgp_asn merged into localhost entry (older bgpcfgd
                        versions read the local ASN from here, not BGP_GLOBALS)

   Single Spine ASN design:
     Both Spine_S1 and Spine_S2 share ASN 65000. Leaf switches configure
     bgp_bestpath_multipath_relax=true (in leaves.yml) so that both spine
     uplinks (same ASN in path) are installed as ECMP routes via FRR's
     'bgp bestpath as-path multipath-relax'. Spines do NOT need this setting
     because each leaf peer has a unique ASN (65011–65022).
   =============================================================================#}
{#
   _fabric_links is set by sonic_fabric/tasks/main.yml:
     _fabric_links = (fabric_interfaces | default(uplink_interfaces))
                     | selectattr('neighbor', 'in', ansible_play_hosts)
   This is the ONLY interface list used — never the raw host_var lists.

   NOTE: For border leaves, exit_interfaces use sub-port names (e.g. Ethernet5/1)
   that only exist AFTER breakout. The deploy_breakout.yml playbook must run
   before this fabric patch. The fabric template handles both:
     - Unnumbered peers (spine uplinks): interface-based BGP (Ethernet120, etc.)
     - IP-based peers (exit router): neighbor_ip defined, uses sub-port name
#}
{% set ifaces = _fabric_links %}
{# Build list of fabric port names for filtering breakout_cfg #}
{% set fabric_port_names = ifaces | map(attribute='port') | list %}
{# Split interfaces into unnumbered (spine-leaf) vs IP-based (exit router) peers.
   IP-based peers have neighbor_ip defined in host_vars (exit_interfaces). #}
{% set unnumbered_ifaces = ifaces | rejectattr('neighbor_ip', 'defined') | list %}
{% set ip_based_ifaces = ifaces | selectattr('neighbor_ip', 'defined') | list %}
{#
   Filter breakout_cfg (host_var) to only include fabric ports in this play.
   breakout_cfg is a dict: {"Ethernet0": {"brkout_mode": "4x10G"}, ...}
   Server downlink breakouts (also in breakout_cfg) are excluded here —
   they are managed exclusively by the day-0 role.
#}
{% set ns = namespace(fabric_breakout=[]) %}
{% for port_name, brkout in (breakout_cfg | default({})).items() %}
{%   if port_name in fabric_port_names %}
{%     set ns.fabric_breakout = ns.fabric_breakout + [{'port': port_name, 'mode': brkout.brkout_mode}] %}
{%   endif %}
{% endfor %}
{
    "PORT": {
{% for iface in ifaces %}
        "{{ iface.port }}": {
            "admin_status": "{{ fabric_port_admin_status }}",
            "speed":        "{{ iface.speed }}",
            "mtu":          "{{ fabric_port_mtu }}",
            "fec":          "{{ fabric_port_fec }}",
            "description":  "{{ iface.description }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

{% if ns.fabric_breakout | length > 0 %}
    "BREAKOUT_CFG": {
{% for item in ns.fabric_breakout %}
        "{{ item.port }}": {
            "brkout_mode": "{{ item.mode }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

{% endif %}
    "INTERFACE": {
{% for iface in unnumbered_ifaces %}
        "{{ iface.port }}": {
            "ipv6_use_link_local_only": "{{ fabric_ipv6_link_local_only }}"
        }{{ "," if not loop.last or ip_based_ifaces | length > 0 else "" }}
{% endfor %}
{% for iface in ip_based_ifaces %}
        "{{ iface.port }}": {},
        "{{ iface.port }}|{{ iface.local_ip }}": {}{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "BGP_NEIGHBOR": {
{% for iface in unnumbered_ifaces %}
        "{{ iface.port }}": {
            "asn":          "{{ iface.neighbor_asn }}",
            "name":         "{{ iface.neighbor }}",
            "local_addr":   "{{ iface.port }}",
            "admin_status": "true",
            "holdtime":     "{{ bgp_holdtime }}",
            "keepalive":    "{{ bgp_keepalive }}",
            "nhopself":     "0",
            "rrclient":     "0"
        }{{ "," if not loop.last or ip_based_ifaces | length > 0 else "" }}
{% endfor %}
{% for iface in ip_based_ifaces %}
        "{{ iface.neighbor_ip }}": {
            "asn":          "{{ iface.neighbor_asn }}",
            "name":         "{{ iface.neighbor }}",
            "local_addr":   "{{ iface.local_ip.split('/')[0] }}",
            "admin_status": "true",
            "holdtime":     "{{ bgp_holdtime }}",
            "keepalive":    "{{ bgp_keepalive }}",
            "nhopself":     "0",
            "rrclient":     "0"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "BGP_NEIGHBOR_AF": {
{% for iface in unnumbered_ifaces %}
        "{{ iface.port }}|ipv4": {
            "admin_status": "true"
        },
        "{{ iface.port }}|ipv6": {
            "admin_status": "true"
        }{{ "," if not loop.last or ip_based_ifaces | length > 0 else "" }}
{% endfor %}
{% for iface in ip_based_ifaces %}
        "{{ iface.neighbor_ip }}|ipv4": {
            "admin_status": "true"
        },
        "{{ iface.neighbor_ip }}|ipv6": {
            "admin_status": "true"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "BGP_GLOBALS": {
        "default": {
            "local_asn":  "{{ bgp_local_asn }}",
            "router_id":  "{{ router_id }}",
            "bestpath_as_path_multipath_relax": "{{ bgp_bestpath_multipath_relax | default('false') }}"
        }
    },

    "BGP_GLOBALS_AF": {
        "default|ipv4": {
            "max_paths": "{{ bgp_max_paths | default('8') }}"
        },
        "default|ipv6": {
            "max_paths": "{{ bgp_max_paths | default('8') }}"
        },
        "default|l2vpn_evpn": {
            "max_paths": "{{ bgp_max_paths | default('8') }}"
        }
    },

    "DEVICE_METADATA": {
        "localhost": {
            "bgp_asn": "{{ bgp_local_asn }}"
        }
    },

{% if syslog_servers is defined and syslog_servers | length > 0 %}
{#  SYSLOG_SERVER — Centralized syslog destinations.
    SONiC sends all rsyslog output to these remote servers (UDP 514).
    The MonitorSrv loopback (10.10.255.102) is reachable from all switches
    via BGP, providing reliable log delivery across the entire fabric.
    Supports multiple servers for redundancy.
#}
    "SYSLOG_SERVER": {
{% for srv in syslog_servers %}
        "{{ srv }}": {}{{ "," if not loop.last else "" }}
{% endfor %}
    },

{% endif %}
{% if ecmp_hash_enabled | default(true) | bool %}
{#  SWITCH_HASH — ECMP Symmetric Hashing + Inner Packet Fields
    SONiC 202305+ supports the SWITCH_HASH table to control LAG/ECMP hash.
    Symmetric hashing ensures A→B and B→A traverse the same ECMP path,
    preventing asymmetric forwarding issues with stateful flows.
    Inner packet fields hash on the encapsulated packet header for
    VXLAN/GRE/IP-in-IP traffic — prevents hash polarization where all
    tunneled traffic to the same VTEP hits a single spine link.
#}
    "SWITCH_HASH": {
        "GLOBAL": {
            "ecmp_hash_algorithm": "CRC",
            "lag_hash_algorithm": "CRC",
            "ecmp_hash": "{{ ecmp_hash_fields | join(',') }}",
            "ecmp_hash_seed": "100",
            "ecmp_hash_offset": "0"
        }
    },

    "HASH": {
        "ecmp": {
            "hash_field@": "{{ ecmp_hash_fields | join(',') }}",
            "algorithm": "CRC"
        }
    },

    "SYMMETRIC_HASH": {
        "GLOBAL": {
            "symmetric_hash": "{{ ecmp_hash_symmetric }}"
        }
    },

{% endif %}
{% if bfd_enabled | default(true) | bool %}
{#  BFD_PEER_SINGLE_HOP — Sub-second failure detection on fabric links.
    SONiC's bfdd creates a BFD session per entry. Once the session goes down,
    FRR's bgpd (with 'neighbor X bfd' configured via bgpcfgd) withdraws the
    BGP neighbor immediately — no need to wait for holdtime expiry.

    For unnumbered links the peer is identified by interface, not IP. The key
    format is "default|<interface>" (default VRF). SONiC 4.x+ also supports
    "Vrf_xxx|<interface>" for multi-VRF BFD.

    Detection time = rx_interval × multiplier = {{ bfd_rx_interval }}ms × {{ bfd_multiplier }} = {{ (bfd_rx_interval | int) * (bfd_multiplier | int) }}ms
#}
    "BFD_PEER_SINGLE_HOP": {
{% for iface in ifaces %}
        "default|{{ iface.port }}": {
            "local_addr":          "{{ iface.port }}",
            "multihop":            "false",
            "enabled":             "true",
            "desired_tx_interval": "{{ bfd_tx_interval }}",
            "required_rx_interval":"{{ bfd_rx_interval }}",
            "detect_multiplier":   "{{ bfd_multiplier }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },
{% endif %}

{#  BGP_NEIGHBOR max-prefix — Prevents route-leak or table explosion.
    For leaf→spine: cap at bgp_maxprefix_leaf_to_spine (default 200)
    For spine→leaf: cap at bgp_maxprefix_spine_to_leaf (default 500)
    The device_role variable (leaf/spine/borderleaf) determines which limit applies.
    On threshold breach: warn at 80%, teardown + restart after timer.
#}
{% set max_prefix = bgp_maxprefix_leaf_to_spine if device_role | default('leaf') in ['leaf', 'borderleaf'] else bgp_maxprefix_spine_to_leaf %}
    "BGP_NEIGHBOR_MAX_PREFIX": {
{% for iface in ifaces %}
        "{{ iface.port }}|ipv4": {
            "max_prefix": "{{ max_prefix }}",
            "warning_percentage": "{{ bgp_maxprefix_warning_percent }}",
            "restart_timer": "{{ bgp_maxprefix_restart_timer }}"
        },
        "{{ iface.port }}|ipv6": {
            "max_prefix": "{{ max_prefix }}",
            "warning_percentage": "{{ bgp_maxprefix_warning_percent }}",
            "restart_timer": "{{ bgp_maxprefix_restart_timer }}"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    }

{% if prefix_filter_enabled | default(true) | bool and device_role | default('leaf') == 'spine' %}
{#  BGP_PREFIX_LIST / ROUTE_MAP on spines:
    Only accept /32 loopbacks and /24 server subnets from leaves.
    Prevents accidental default-route leak from any leaf or external source.
#}
    ,"ROUTE_MAP": {
        "FABRIC_IN|10": {
            "match": "ip address prefix-list FABRIC_PREFIXES_IN",
            "action": "permit"
        },
        "FABRIC_IN|999": {
            "action": "deny"
        }
    },

    "PREFIX_LIST": {
        "FABRIC_PREFIXES_IN|10": {
            "prefix": "10.0.0.0/8 ge 32 le 32",
            "action": "permit"
        },
        "FABRIC_PREFIXES_IN|20": {
            "prefix": "10.10.0.0/16 ge 24 le 24",
            "action": "permit"
        },
        "FABRIC_PREFIXES_IN|30": {
            "prefix": "10.10.255.0/24 ge 32 le 32",
            "action": "permit"
        }
    }
{% endif %}
}
