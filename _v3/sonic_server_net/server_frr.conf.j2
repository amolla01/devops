! FRR configuration for {{ hostname }}
! Generated by Ansible — do not edit manually
! BGP Unnumbered — peering via link-local IPv6 on fabric interfaces
!
frr version 8.5.4
frr defaults datacenter
hostname {{ hostname }}
log syslog informational
ip forwarding
ipv6 forwarding
service integrated-vtysh-config
!
router bgp {{ server_asn }}
 bgp router-id {{ server_router_id }}
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 bgp bestpath as-path multipath-relax
 !
{% for iface in _server_interfaces %}
 neighbor {{ iface.name }} interface v6only remote-as {{ iface.peer_asn }}
 neighbor {{ iface.name }} description {{ iface.neighbor }}
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ server_loopback_ip }}
{% for iface in _server_interfaces %}
  neighbor {{ iface.name }} activate
  neighbor {{ iface.name }} soft-reconfiguration inbound
{% endfor %}
  maximum-paths {{ _server_interfaces | length }}
 exit-address-family
 !
 address-family ipv6 unicast
{% for iface in _server_interfaces %}
  neighbor {{ iface.name }} activate
{% endfor %}
 exit-address-family
!
line vty
!
