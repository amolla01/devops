---
# =============================================================================
# roles/ceph/templates/rook-ceph-cluster-values.yml.j2 — Rook CephCluster CR
# =============================================================================
# Helm values for rook-ceph-cluster chart (deploys CephCluster CR + toolbox).
# Optimized for KVM lab: reduced resources, single-network, 2 MON / all OSDs.
# =============================================================================

operatorNamespace: {{ rook_ceph_namespace }}

toolbox:
  enabled: true
  resources:
    limits:
      memory: "256Mi"
    requests:
      memory: "64Mi"
      cpu: "50m"

monitoring:
  enabled: true
  createPrometheusRules: false

cephClusterSpec:
  cephVersion:
    image: {{ ceph_container_image }}
    allowUnsupported: false

  dataDirHostPath: /var/lib/rook

  mon:
    count: {{ rook_ceph_mon_count | default(1) }}
    allowMultiplePerNode: {{ rook_ceph_mon_allow_multiple_per_node | default(true) }}

  mgr:
    count: 1
    allowMultiplePerNode: true
    modules:
{% for mod in ceph_mgr_modules_enabled | default(['dashboard', 'prometheus', 'balancer', 'crash']) %}
      - name: {{ mod }}
        enabled: true
{% endfor %}

  dashboard:
    enabled: {{ ceph_dashboard_enabled | default(true) | lower }}
    port: {{ ceph_dashboard_port | default(8443) }}
    ssl: true

  network:
    provider: ""
    connections:
      encryption:
        enabled: false
      compression:
        enabled: false

  # Global Ceph config overrides (applied to ceph.conf)
  cephConfig:
    global:
      osd_pool_default_size: "{{ ceph_osd_pool_default_size | default(2) }}"
      osd_pool_default_min_size: "{{ ceph_osd_pool_default_min_size | default(1) }}"

  crashCollector:
    disable: false

  cleanupPolicy:
    confirmation: ""
    sanitizeDisks:
      method: quick
      dataSource: zero
      iteration: 1
    allowUninstallWithVolumes: false

  resources:
    mon:
      limits:
        memory: "1Gi"
      requests:
        cpu: "100m"
        memory: "256Mi"
    mgr:
      limits:
        memory: "1Gi"
      requests:
        cpu: "100m"
        memory: "256Mi"
    osd:
      limits:
        memory: "2Gi"
      requests:
        cpu: "200m"
        memory: "512Mi"
    prepareosd:
      limits:
        memory: "512Mi"
      requests:
        cpu: "100m"
        memory: "128Mi"
    mgr-sidecar:
      limits:
        memory: "256Mi"
      requests:
        cpu: "50m"
        memory: "64Mi"
    crashcollector:
      limits:
        memory: "128Mi"
      requests:
        cpu: "10m"
        memory: "32Mi"

  storage:
{% if ceph_rook_use_all_devices | default(true) %}
    useAllNodes: true
    useAllDevices: true
{% if ceph_rook_device_filter | default('') | length > 0 %}
    deviceFilter: "{{ ceph_rook_device_filter }}"
{% endif %}
{% else %}
    useAllNodes: false
    useAllDevices: false
    nodes:
{% for host in groups['ceph_osd'] %}
      - name: "{{ hostvars[host]['kube_node_name'] | default(host | lower) }}"
{% if hostvars[host]['ceph_osd_devices'] is defined %}
        devices:
{% for dev in hostvars[host]['ceph_osd_devices'] %}
          - name: "{{ dev }}"
{% endfor %}
{% else %}
        useAllDevices: true
{% endif %}
{% endfor %}
{% endif %}

  placement:
    all:
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"

  priorityClassNames:
    mon: system-node-critical
    osd: system-node-critical
    mgr: system-cluster-critical

cephBlockPools:
  - name: kube-rbd
    spec:
      failureDomain: host
      replicated:
        size: {{ ceph_osd_pool_default_size | default(2) }}
      parameters:
        pg_num: "{{ rook_ceph_pool_pg_num | default(32) }}"
        pgp_num: "{{ rook_ceph_pool_pgp_num | default(32) }}"
    storageClass:
      enabled: true
      name: ceph-rbd
      isDefault: true
      reclaimPolicy: Retain
      allowVolumeExpansion: true
      volumeBindingMode: "Immediate"
      parameters:
        imageFormat: "2"
        imageFeatures: layering

cephFileSystems:
{% if ceph_mds_enabled | default(false) %}
  - name: {{ ceph_cluster_name | default('dc-lab-ceph') }}-fs
    spec:
      metadataPool:
        replicated:
          size: {{ ceph_osd_pool_default_size | default(2) }}
      dataPools:
        - failureDomain: host
          replicated:
            size: {{ ceph_osd_pool_default_size | default(2) }}
          name: data0
      metadataServer:
        activeCount: 1
        activeStandby: true
        resources:
          limits:
            memory: "1Gi"
          requests:
            cpu: "100m"
            memory: "256Mi"
    storageClass:
      enabled: true
      isDefault: false
      name: ceph-filesystem
      reclaimPolicy: Retain
      allowVolumeExpansion: true
      volumeBindingMode: "Immediate"
      pool: data0
{% else %}
  []
{% endif %}

cephObjectStores:
{% if ceph_rgw_enabled | default(false) %}
  - name: {{ ceph_cluster_name | default('dc-lab-ceph') }}-store
    spec:
      metadataPool:
        failureDomain: host
        replicated:
          size: {{ ceph_osd_pool_default_size | default(2) }}
      dataPool:
        failureDomain: host
        replicated:
          size: {{ ceph_osd_pool_default_size | default(2) }}
      preservePoolsOnDelete: true
      gateway:
        port: {{ ceph_rgw_port | default(8080) }}
        securePort: {{ ceph_rgw_secure_port | default(8443) }}
        instances: {{ ceph_rgw_instances | default(1) }}
        resources:
          limits:
            memory: "1Gi"
          requests:
            cpu: "100m"
            memory: "256Mi"
      healthCheck:
        bucket:
          interval: 60s
    storageClass:
      enabled: true
      name: ceph-bucket
      reclaimPolicy: Retain
      parameters:
        region: us-east-1
{% else %}
  []
{% endif %}
