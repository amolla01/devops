name: sheba

prefix: ""

mgmt:
  network: sonic_oob_mgmt
  ipv4-subnet: 172.16.2.0/24

topology:
  defaults:
    env:
      USERNAME: "admin"
      PASSWORD: "admin"
      SONIC_CONFIG_MODE: "unified"
      QEMU_CPU: "qemu64"
      QEMU_SMP: "4"

  kinds:
    sonic-vm:
      image: vrnetlab/sonic_sonic-vs:202605
    generic_vm:
      image: local-ubuntu:26.04
      env:
        USERNAME: "nh1221"
        PASSWORD: "Welcome01!"
      # exec:
      #   - sh -c "ip link set dev eth1 up >/dev/null 2>&1 || true"
      #   - sh -c "ip link set dev eth2 up >/dev/null 2>&1 || true"
      #   - sh -c "ip link set dev eth3 up >/dev/null 2>&1 || true"

  nodes:
    # ==========================================
    # SPINE LAYER — Celestica Seastone-DX010 (32x40G QSFP+)
    # ==========================================
    Spine-S1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.11
      binds:
        - configs/celestica-dx010/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Spine-S2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.12
      binds:
        - configs/celestica-dx010/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # LEAF COLUMN 1 — Accton AS5712-54X (48x10G + 6x40G)
    # ==========================================
    Leaf-L1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.21
      binds:
        - configs/accton-as5712/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Leaf-L2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.22
      binds:
        - configs/accton-as5712/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # LEAF COLUMN 2 — Arista 7050-QX-32 (32x40G QSFP+)
    # ==========================================
    Leaf-L3:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.23
      binds:
        - configs/arista-7050qx-32/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Leaf-L4:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.24
      binds:
        - configs/arista-7050qx-32/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # BORDER LEAF COLUMN — Arista 7050-QX-32S (32x40G QSFP+)
    # ==========================================
    Border-Leaf1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.31
      binds:
        - configs/arista-7050qx-32s/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Border-Leaf2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.32
      binds:
        - configs/arista-7050qx-32s/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # EXIT ROUTERS (2 Nodes)
    # ==========================================
    Exit-Router1:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.41
      labels: { ansible_group: exit_routers }
    Exit-Router2:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.42
      labels: { ansible_group: exit_routers }

    # ==========================================
    # ISP ROUTERS (2 Nodes)
    # ==========================================
    ISP-1:
      kind: generic_vm
      image: quay.io/frrouting/frr:10.0.1
      mgmt-ipv4: 172.16.2.61
      labels: { ansible_group: isp_routers }
    ISP-2:
      kind: generic_vm
      image: quay.io/frrouting/frr:10.0.1
      mgmt-ipv4: 172.16.2.62
      labels: { ansible_group: isp_routers }

    # ==========================================
    # UBUNTU COMPUTE/MONITORING WORKLOAD SERVERS (9 Nodes)
    # ==========================================
    Host12-1:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.51
      labels: { ansible_group: compute_hosts }
    Host12-2:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.52
      labels: { ansible_group: compute_hosts }
    Host12-3:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.53
      labels: { ansible_group: compute_hosts }
    Host34-1:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.54
      labels: { ansible_group: compute_hosts }
    Host34-2:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.55
      labels: { ansible_group: compute_hosts }
    MonSrv:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.56
      labels: { ansible_group: monitoring_hosts }
    HostB12-1:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.57
      labels: { ansible_group: compute_hosts }
    HostB12-2:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.58
      labels: { ansible_group: compute_hosts }
    oob-mgmt-node:
      kind: generic_vm
      mgmt-ipv4: 172.16.2.254
      labels: { ansible_group: management_nodes }


  links:
    # =========================================================================
    # SPINE-S1 FABRIC UPLINKS (Spine eth1-6 = Spine Ethernet0,4,8,12,16,20)
    # Leaf/BL ethN = name-sorted position AFTER breakout (35 ports):
    #   Eth120=pos34→eth34, Eth124=pos35→eth35
    # Accton ethN = name-sorted position (72 ports):
    #   Eth68=pos69→eth69, Eth64=pos65→eth65
    # =========================================================================
    - endpoints: ["Spine-S1:eth1", "Leaf-L1:eth69"]      # Spine Eth0  <---> Leaf-L1 Eth68 (40G)
    - endpoints: ["Spine-S1:eth2", "Leaf-L2:eth69"]      # Spine Eth4  <---> Leaf-L2 Eth68 (40G)
    - endpoints: ["Spine-S1:eth3", "Leaf-L3:eth35"]      # Spine Eth8  <---> Leaf-L3 Eth124 (40G)
    - endpoints: ["Spine-S1:eth4", "Leaf-L4:eth35"]      # Spine Eth12 <---> Leaf-L4 Eth124 (40G)
    - endpoints: ["Spine-S1:eth5", "Border-Leaf1:eth35"] # Spine Eth16 <---> Border-Leaf1 Eth124 (40G)
    - endpoints: ["Spine-S1:eth6", "Border-Leaf2:eth35"] # Spine Eth20 <---> Border-Leaf2 Eth124 (40G)

    # =========================================================================
    # SPINE-S2 FABRIC UPLINKS
    # =========================================================================
    - endpoints: ["Spine-S2:eth1", "Leaf-L1:eth65"]      # Spine Eth0  <---> Leaf-L1 Eth64 (40G)
    - endpoints: ["Spine-S2:eth2", "Leaf-L2:eth65"]      # Spine Eth4  <---> Leaf-L2 Eth64 (40G)
    - endpoints: ["Spine-S2:eth3", "Leaf-L3:eth34"]      # Spine Eth8  <---> Leaf-L3 Eth120 (40G)
    - endpoints: ["Spine-S2:eth4", "Leaf-L4:eth34"]      # Spine Eth12 <---> Leaf-L4 Eth120 (40G)
    - endpoints: ["Spine-S2:eth5", "Border-Leaf1:eth34"] # Spine Eth16 <---> Border-Leaf1 Eth120 (40G)
    - endpoints: ["Spine-S2:eth6", "Border-Leaf2:eth34"] # Spine Eth20 <---> Border-Leaf2 Eth120 (40G)

    # =========================================================================
    # LEAF-L1 ACCESS CONNECTIONS (Eth0=eth1, Eth1=eth2, Eth2=eth3)
    # =========================================================================
    - endpoints: ["Leaf-L1:eth1", "Host12-1:eth1"]       # Leaf-L1 Eth0 <---> Host12-1 Port 1 (10G)
    - endpoints: ["Leaf-L1:eth2", "Host12-2:eth1"]       # Leaf-L1 Eth1 <---> Host12-2 Port 1 (10G)
    - endpoints: ["Leaf-L1:eth3", "Host12-3:eth1"]       # Leaf-L1 Eth2 <---> Host12-3 Port 1 (10G)

    # =========================================================================
    # LEAF-L2 ACCESS CONNECTIONS (Mirrored to Leaf-L1 for Multi-Homing)
    # =========================================================================
    - endpoints: ["Leaf-L2:eth1", "Host12-1:eth2"]       # Leaf-L2 Eth0 <---> Host12-1 Port 2 (10G)
    - endpoints: ["Leaf-L2:eth2", "Host12-2:eth2"]       # Leaf-L2 Eth1 <---> Host12-2 Port 2 (10G)
    - endpoints: ["Leaf-L2:eth3", "Host12-3:eth2"]       # Leaf-L2 Eth2 <---> Host12-3 Port 2 (10G)

    # =========================================================================
    # LEAF-L3 ACCESS BREAKOUTS (Eth0=eth1, Eth1=eth2, Eth2=eth3)
    # =========================================================================
    - endpoints: ["Leaf-L3:eth1", "Host34-1:eth1"]       # Leaf-L3 Eth0 <---> Host34-1 Port 1 (10G)
    - endpoints: ["Leaf-L3:eth2", "Host34-2:eth1"]       # Leaf-L3 Eth1 <---> Host34-2 Port 1 (10G)
    - endpoints: ["Leaf-L3:eth3", "MonSrv:eth1"]         # Leaf-L3 Eth2 <---> MonSrv Port 1 (10G)

    # =========================================================================
    # LEAF-L4 ACCESS BREAKOUTS (Mirrored to Leaf-L3 for Multi-Homing)
    # =========================================================================
    - endpoints: ["Leaf-L4:eth1", "Host34-1:eth2"]       # Leaf-L4 Eth0 <---> Host34-1 Port 2 (10G)
    - endpoints: ["Leaf-L4:eth2", "Host34-2:eth2"]       # Leaf-L4 Eth1 <---> Host34-2 Port 2 (10G)
    - endpoints: ["Leaf-L4:eth3", "MonSrv:eth2"]         # Leaf-L4 Eth2 <---> MonSrv Port 2 (10G)
    # =========================================================================
    # BORDER-LEAF1 EDGE/ISP CONNECTIONS (Eth0=eth1, Eth1=eth2, Eth2=eth3, Eth3=eth4)
    # =========================================================================
    - endpoints: ["Border-Leaf1:eth1", "Exit-Router1:eth1"] # BL1 Eth0 <---> Exit-Router1 enp2s0 (10G)
    - endpoints: ["Border-Leaf1:eth2", "Exit-Router2:eth1"]   # BL1 Eth1 <---> Exit-Router2 eth1 (10G)
    - endpoints: ["Border-Leaf1:eth3", "HostB12-1:eth1"]      # BL1 Eth2 <---> HostB12-1 Port 1 (10G)
    - endpoints: ["Border-Leaf1:eth4", "HostB12-2:eth1"]      # BL1 Eth3 <---> HostB12-2 Port 1 (1G)

    # =========================================================================
    # BORDER-LEAF2 EDGE/ISP CONNECTIONS (Mirrored to Border-Leaf1)
    # =========================================================================
    - endpoints: ["Border-Leaf2:eth1", "Exit-Router2:eth2"]   # BL2 Eth0 <---> Exit-Router2 eth2 (10G)
    - endpoints: ["Border-Leaf2:eth2", "Exit-Router1:eth2"] # BL2 Eth1 <---> Exit-Router1 enp3s0 (10G)
    - endpoints: ["Border-Leaf2:eth3", "HostB12-1:eth2"]      # BL2 Eth2 <---> HostB12-1 Port 2 (10G)
    - endpoints: ["Border-Leaf2:eth4", "HostB12-2:eth2"]      # BL2 Eth3 <---> HostB12-2 Port 2 (10G)
    # ------------------------------------------
    # WAN / ISP UPLINK LINKAGES
    # ------------------------------------------
    - endpoints: ["ISP-1:eth1", "Exit-Router1:eth3"]
    - endpoints: ["ISP-2:eth1", "Exit-Router1:eth4"]
    - endpoints: ["ISP-1:eth2", "Exit-Router2:eth3"]
    - endpoints: ["ISP-2:eth2", "Exit-Router2:eth4"]
    
