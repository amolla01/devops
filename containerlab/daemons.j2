zebra=yes
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd={{ 'yes' if (bfd_enabled | default(true)) else 'no' }}
fabricd=no
vrrpd=no
pathd=no

#
# Per-daemon startup options.
# zebra --no-nhg: install ECMP as classic per-route multipath (inline nexthops)
# instead of shared kernel nexthop-GROUP objects. On this virtual (KVM/sonic-vs)
# RFC5549-unnumbered fabric, a single IPv6 link-local neighbor flapping to FAILED
# makes the kernel delete the singleton nexthop object, cascade-invalidate the
# ECMP group, and reject re-install ("Invalid nexthop id" / "Failed to install
# Nexthop group"), silently dropping every multipath route from the FIB. Classic
# multipath has no shared group object to tear down, so routes survive the churn.
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000 --no-nhg"
mgmtd_options="  -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
