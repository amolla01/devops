{# --- Post-reload overlay: sets admin_status up for connected ports --- #}
{
    "LOOPBACK_INTERFACE": {
        "Loopback0": {},
        "Loopback0|{{ router_id }}/32": {}
    },

    "PORT": {
{% set connected = switch_ports.keys() | list + (access_ports.keys() | list if access_ports is defined else []) %}
{% for port_name in connected %}
        "{{ port_name }}": {
            "admin_status": "up"
        }{{ "," if not loop.last else "" }}
{% endfor %}
    },

    "INTERFACE": {
{% for port_name in switch_ports %}
        "{{ port_name }}": {}{{ "," if not loop.last else "" }}
{% endfor %}
    }
}
