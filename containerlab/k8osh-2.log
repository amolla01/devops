name: sheba

prefix: ""

mgmt:
  network: sonic_oob_mgmt
  ipv4-subnet: 172.16.2.0/24

topology:
  defaults:
    env:
      USERNAME: "admin"
      PASSWORD: "admin"
      SONIC_CONFIG_MODE: "unified"
      QEMU_CPU: "qemu64"
      QEMU_SMP: "4"
      CLAB_MGMT_PASSTHROUGH: "true"
  kinds:
    sonic-vm:
      image: vrnetlab/sonic_sonic-vs:202605
    linux:
      image: vrnetlab/canonical_ubuntu:resolute

  nodes:
    # ==========================================
    # SPINE LAYER — Celestica Seastone-DX010 (32x40G QSFP+)
    # ==========================================
    Spine-S1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.11
      binds:
        - configs/celestica-dx010/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Spine-S2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.12
      binds:
        - configs/celestica-dx010/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # LEAF COLUMN 1 — Accton AS5712-54X (48x10G + 6x40G)
    # ==========================================
    Leaf-L1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.21
      binds:
        - configs/accton-as5712/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Leaf-L2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.22
      binds:
        - configs/accton-as5712/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # LEAF COLUMN 2 — Arista 7050-QX-32 (32x40G QSFP+)
    # ==========================================
    Leaf-L3:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.23
      binds:
        - configs/arista-7050qx-32/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Leaf-L4:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.24
      binds:
        - configs/arista-7050qx-32/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # BORDER LEAF COLUMN — Arista 7050-QX-32S (32x40G QSFP+)
    # ==========================================
    Border-Leaf1:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.31
      binds:
        - configs/arista-7050qx-32s/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    Border-Leaf2:
      kind: sonic-vm
      mgmt-ipv4: 172.16.2.32
      binds:
        - configs/arista-7050qx-32s/config.sh:/etc/rc.local.d/init-platform.sh
      exec:
        - bash /etc/rc.local.d/init-platform.sh &

    # ==========================================
    # EXIT ROUTERS (2 Nodes)
    # ==========================================
    Exit-Router1:
      kind: linux
      mgmt-ipv4: 172.16.2.41
      labels: { ansible_group: exit_routers }
    Exit-Router2:
      kind: linux
      mgmt-ipv4: 172.16.2.42
      labels: { ansible_group: exit_routers }

    # ==========================================
    # ISP ROUTERS (2 Nodes)
    # ==========================================
    ISP-1:
      kind: linux
      image: quay.io/frrouting/frr:10.0.1
      mgmt-ipv4: 172.16.2.98
      labels: { ansible_group: isp_routers }
    ISP-2:
      kind: linux
      image: quay.io/frrouting/frr:10.0.1
      mgmt-ipv4: 172.16.2.99
      labels: { ansible_group: isp_routers }

    # Exit-Router1:
    #   kind: linux
    #   mgmt-ipv4: {{ hostvars['Exit-Router1']['ansible_host'] }}
    #   labels: { ansible_group: exit_routers }

    # Exit-Router2:
    #   kind: linux
    #      CLAB_MGMT_PASSTHROUGH: "true"
    #   mgmt-ipv4: {{ hostvars['Exit-Router2']['ansible_host'] }}
    #   labels: { ansible_group: exit_routers }

    # ISP-1:
    #   kind: linux
    #   image: quay.io/frrouting/frr:10.0.1
    #   mgmt-ipv4: 172.16.2.98
    #   labels: { ansible_group: isp_routers }

    # ISP-2:
    #   kind: linux
    #   image: quay.io/frrouting/frr:10.0.1
    #   mgmt-ipv4: 172.16.2.99
    #   labels: { ansible_group: isp_routers }

{% for host_name in workers %}
    {{ host_name }}:
      kind: linux
      mgmt-ipv4: {{ hostvars[host_name]['ansible_host'] }}
      env:
        QEMU_CPU: "host"
        QEMU_SMP: "{{ '8' if host_name in ['osh-comp-01', 'osh-comp-02', 'osh-comp-03'] else ('6' if host_name in ['k8s-db-01', 'k8s-db-02', 'k8s-db-03', 'MonSrv', 'osh-comp-04'] else '2') }}"
        QEMU_MEMORY: "{{ '20480' if host_name in ['osh-comp-01', 'osh-comp-02', 'osh-comp-03'] else ('10240' if host_name in ['k8s-db-01', 'k8s-db-02', 'k8s-db-03', 'MonSrv', 'osh-comp-04'] else '4096') }}"
        QEMU_ADDITIONAL_ARGS: >-
          -drive file=/seed.iso,media=cdrom,readonly=on
          -drive file=/data.qcow2,if=none,id=drvSystem,format=qcow2
          -device virtio-blk-pci,drive=drvSystem,id=vblkSystem,addr=0x4
{% if host_name in ['osh-comp-01', 'osh-comp-02', 'osh-comp-03'] %}
          -drive file={{ hostvars[host_name].physical_ceph_disk_a | default('/dev/sdb') }},if=none,id=drvCephA,format=raw
          -device virtio-blk-pci,drive=drvCephA,id=vblkCephA,addr=0x5
{% endif %}
      binds:
        - configs/cloud-init/seed.iso:/seed.iso:ro
        - configs/vmdisks/{{ host_name }}-data.qcow2:/data.qcow2
        - ~/.ssh/id_dc_lab.pub:/home/ubuntu/.ssh/authorized_keys:ro
{% if host_name in ['osh-comp-01', 'osh-comp-02', 'osh-comp-03'] %}
        - {{ hostvars[host_name].physical_ceph_disk_a | default('/dev/sdb') }}:{{ hostvars[host_name].physical_ceph_disk_a | default('/dev/sdb') }}:rw
{% endif %}
      labels: { ansible_group: "{{ host_label_map[host_name] }}" }
{% endfor %}

    oob-mgmt-node:
      kind: linux
      mgmt-ipv4: 172.16.2.254
      # L2 bridge over its data ports (represents the OOB mgmt switch instance)
      exec:
        - ip link add name br-mgmt type bridge
        - ip link set br-mgmt up
        - ip link set eth1 master br-mgmt
        - ip link set eth2 master br-mgmt
        - ip link set eth1 up
        - ip link set eth2 up
      labels: { ansible_group: management_nodes }

    External-Router:
      kind: linux
      image: quay.io/frrouting/frr:10.0.1
      mgmt-ipv4: 172.16.2.253
      binds:
        - configs/frr/daemons:/etc/frr/daemons:ro
      labels: { ansible_group: external_routers }
      
  links:
    # =========================================================================
    # SPINE-S1 FABRIC UPLINKS (Spine eth1-6 = Spine Ethernet0,4,8,12,16,20)
    # Leaf/BL ethN = name-sorted position AFTER breakout (35 ports):
    #   Eth120=pos34→eth34, Eth124=pos35→eth35
    # Accton ethN = name-sorted position (72 ports):
    #   Eth68=pos69→eth69, Eth64=pos65→eth65
    # =========================================================================
    - endpoints: ["Spine-S1:eth1", "Leaf-L1:eth69"]      # Spine Eth0  <---> Leaf-L1 Eth68 (40G)
    - endpoints: ["Spine-S1:eth2", "Leaf-L2:eth69"]      # Spine Eth4  <---> Leaf-L2 Eth68 (40G)
