nh1221@PowerEdge-R810:~$ for c in k8s-master-01 k8s-master-02 k8s-master-03 k8s-db-01 k8s-db-02 Exit-Router1 Exit-Router2; do
    # Pull the real MAC inside the container namespace
    TRUE_MAC=$(sudo docker exec "$c" ip link show eth0 | grep link/ether | awk '{print $2}')
    IP=$(sudo docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$c")
    BRIDGE=$(ip r sh | grep 172.16.2.0/24 | awk '{print $3}')

    if [ ! -z "$TRUE_MAC" ] && [ ! -z "$IP" ]; then
        echo "Updating neighbor table: $c ($IP) -> True MAC ($TRUE_MAC) on $BRIDGE"
        sudo ip neigh replace "$IP" lladdr "$TRUE_MAC" dev "$BRIDGE" nud permanent
    fi
done
