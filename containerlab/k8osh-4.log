nh1221@PowerEdge-R810:~$ # Dynamically extract runtime MAC addresses and bind them permanently to the R810 neighbor table
for c in k8s-master-01 k8s-master-02 k8s-master-03 k8s-db-01 k8s-db-02 Exit-Router1 Exit-Router2; do
    IP=$(sudo docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$c")
    MAC=$(sudo docker inspect -f '{{range .NetworkSettings.Networks}}{{.MacAddress}}{{end}}' "$c")
    BRIDGE=$(ip r sh | grep 172.16.2.0/24 | awk '{print $3}')

    if [ ! -z "$IP" ] && [ ! -z "$MAC" ]; then
        echo "Mapping $c ($IP) to $MAC on bridge $BRIDGE"
        sudo ip neigh replace "$IP" lladdr "$MAC" dev "$BRIDGE" nud permanent
    fi
done
