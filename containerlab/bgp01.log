json with proper mgmt ip address:
"MGMT_INTERFACE": {
        "eth0|172.16.2.11/24": {
            "gwaddr": "172.16.2.254"
        }
    },
    "MGMT_VRF_CONFIG": {
        "vrf_global": {
            "mgmtVrfEnabled": "true"
        }

