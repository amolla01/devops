links)\n# Detect breakout groups: multiple ports sharing same index with single lane\nidx_groups = defaultdict(list)\nfor port_name, cfg in access_ports.items():\n    idx_groups[str(cfg['index'])].append(port_name)\n\nbreakout_cfg = {}\nfor port_name, cfg in access_ports.items():\n    lanes = str(cfg.get('lanes', ''))\n    idx = str(cfg['index'])\n    speed = str(cfg.get('speed', '10000'))\n\n    port_table[port_name] = {\n        'lanes': lanes,\n        'speed': speed,\n        'index': idx,\n        'admin_status': 'down',\n        'alias': port_name\n    }\n\n    # If this index has multiple ports, it's a breakout group\n    if len(idx_groups[idx]) > 1:\n        parent = sorted(idx_groups[idx], key=lambda x: int(x.replace('Ethernet', '')))[0]\n        if parent not in breakout_cfg:\n            speed_g = int(speed) // 1000\n            num_children = len(idx_groups[idx])\n            breakout_cfg[parent] = {\n                'brkout_mode': '4x{}G[{}G]'.format(speed_g, speed_g)\n            }\n\ndb['PORT'] = port_table\n\nif breakout_cfg:\n    db['BREAKOUT_CFG'] = breakout_cfg\n\n# Set DEVICE_METADATA\ndb.setdefault('DEVICE_METADATA', {}).setdefault('localhost', {})\ndb['DEVICE_METADATA']['localhost'].update({\n    'hostname': 'Leaf-L2',\n    'type': 'LeafRouter',\n    'router_id': '10.0.1.2',\n    'bgp_asn': '65012',\n    'hwsku': 'Accton-AS5712-54X',\n    'platform': 'x86_64-accton_as5712_54x-r0',\n    'frr_mgmt_framework_config': 'true',\n    'docker_routing_config_mode': 'unified'\n})\n\n# Remove any preset cruft from initial boot config\nfor key in ['BGP_NEIGHBOR', 'DEVICE_NEIGHBOR']:\n    db.pop(key, None)\n\nwith open('/etc/sonic/config_db.json', 'w') as f:\n    json.dump(db, f, indent=4)\n\"\n", "delta": "0:00:00.057037", "end": "2026-08-02 00:09:43.878083", "msg": "non-zero return code", "rc": 1, "start": "2026-08-02 00:09:43.821046", "stderr": "  File \"<string>\", line 19\n    switch_ports = {Ethernet68: {speed: 40000, role: fabric, lanes: 77,78,79,80,