BorderLeaf2# show running-config
Building configuration...

Current configuration:
!
frr version 8.5.4
frr defaults traditional
hostname sonic
log syslog informational
log facility local4
no zebra nexthop kernel enable
fpm address 127.0.0.1
no fpm use-next-hop-groups
agentx
hostname BorderLeaf2
no service integrated-vtysh-config
!
password zebra
enable password zebra
!
router bgp 65022
 bgp router-id 10.0.2.2
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 neighbor Ethernet20 interface v6only remote-as 65106
 neighbor Ethernet20 description HostB12_1
 neighbor Ethernet24 interface v6only remote-as 65107
 neighbor Ethernet24 description HostB12_2
 neighbor Ethernet28 interface v6only remote-as 65108
 neighbor Ethernet28 description MonitorSrv
 neighbor Ethernet120 interface v6only remote-as external
 neighbor Ethernet120 description Spine_S2
 neighbor Ethernet124 interface v6only remote-as external
 neighbor Ethernet124 description Spine_S1
 neighbor 10.0.253.3 remote-as 65254
 neighbor 10.0.253.3 description Exit_Router2
 neighbor 10.0.253.3 update-source Ethernet0
 !
 address-family ipv4 unicast
  redistribute connected
  neighbor Ethernet20 activate
  neighbor Ethernet20 soft-reconfiguration inbound
  neighbor Ethernet24 activate
  neighbor Ethernet24 soft-reconfiguration inbound
  neighbor Ethernet28 activate
  neighbor Ethernet28 soft-reconfiguration inbound
  neighbor Ethernet120 activate
  neighbor Ethernet124 activate
  neighbor 10.0.253.3 activate
 exit-address-family
 !
 address-family ipv6 unicast
  redistribute connected
  neighbor Ethernet20 activate
  neighbor Ethernet24 activate
  neighbor Ethernet28 activate
  neighbor Ethernet120 activate
  neighbor Ethernet124 activate
 exit-address-family
exit
!
ip prefix-list PL_LoopbackV4 seq 5 permit 10.1.0.1/32
!
route-map RM_SET_SRC permit 10
 set src 10.0.2.2
exit
!
ip nht resolve-via-default
!
ipv6 nht resolve-via-default
!
ip protocol bgp route-map RM_SET_SRC
!
end
